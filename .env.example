PORT=3000
DATABASE_URL=postgres://rag:rag_secret@localhost:5432/rag_db
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536
# Minimum cosine similarity (0-1) to include a chunk in context
RETRIEVAL_MIN_SCORE=0.0
# Top-K chunks to retrieve
RETRIEVAL_TOP_K=5
# Optional: enable mock embeddings when no API key(only DEV)
MOCK_LLM=true
