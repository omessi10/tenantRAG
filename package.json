{
  "name": "infoware-rag",
  "version": "1.0.0",
  "description": "Multi-tenant RAG system with strict tenant isolation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "openai": "^4.103.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.0",
    "pgvector": "^0.2.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
